(defun MainLayer ()
  (command "LINETYPE" "S" "BYLAYER" "" "LWEIGHT" 0.5 "" "COLOR" "white")
)

(defun AxisLayer ()
  (command "LINETYPE" "S" "CENTER" "" "LWEIGHT" 0.3 "" "COLOR" 30)
)

(defun SizeLayer ()
  (command "LINETYPE" "S" "BYLAYER" "" "LWEIGHT" 0.3 "" "COLOR" 150)
)

(defun c:gasket ()
  (command "OSNAP" "OFF")
  (command "SNAP" "OFF")
  (command "LTSCALE" 0.15)
  (command "LWDISPLAY" 1)
  (AxisLayer)
  (command "xline" "h" (list 0 0) "")
  (command "xline" "v" (list 0 0) (list 200 0) "")
  (MainLayer)
  (command "ZOOM" "All")
  (command "CIRCLE" (list 0 0) "D" 92)
  (command "CIRCLE" (list 0 0) "D" 140)
  (command "CIRCLE" (list 200 0) "D" 40)
  (command "CIRCLE" (list 200 0) "D" 80)
  (command "PLINE" (list 200 40) (list 120 40) (list 120 60) (list 0 60) "")
  (command "MIRROR" (list 110 60) "" (list 200 0) (list 400 0) "N")
  (command "TRIM" (list 10 -60) (list 10 60) "")
  (command "CIRCLE" (list 0 0) "D" 150)
  (command "CIRCLE" (list 200 0) "D" 90)
  (command "TRIM" (list 0 80) (list -80 0) (list 0 -80) (list 200 50) (list 250 0) (list 200 -50) "")
)