% A small dataset of Countries (Socio-Economic, Country Flag) created by Richard Forsyth

@RELATION Eurodata

@ATTRIBUTE flagred {0, 1}
@ATTRIBUTE flagreen {0, 1}
@ATTRIBUTE flagblue {0, 1}
@ATTRIBUTE flagyog {0, 1}
@ATTRIBUTE flagblack {0, 1}
@ATTRIBUTE flagwhite {0, 1}
@ATTRIBUTE flagcross {0, 1}
@ATTRIBUTE flagbars {0, 2, 3}
@ATTRIBUTE flagstripes {0, 2, 3, 9}
@ATTRIBUTE flagicon {0, 1}
@ATTRIBUTE Country {Austria,Belgium,Cyprus,CzechRep,Denmark,Estonia,Finland,France,Germany,Greece,Hungary,Ireland,Italy,Latvia,Lithuania,Luxembourg,Malta,Netherlands,Poland,Portugal,Slovakia,Slovenia,Spain,Sweden,UK}

